Vagrant.configure("2") do |config|
	config.vm.box = "generic/alpine318"
	config.vm.box_version = "4.3.12"

	config.vm.provider "virtualbox" do |vb|
		vb.memory = "1024"
		vb.cpus = 1
		extern_path = "/media/rihoy/SenkaSamT7/virtualMachina/IoT"
	end
	config.vm.define "rihoyS" do |server|
		server.vm.hostname = "rihoyS"
		server.vm.network = "private_network", ip: "192.168.56.110"
		
		server.vm.provider "virtualbox" do |vb|
			vb.name = "rihoyS"
			vb.customize ["setproperty", "machinefolder", extern_path]
		end

		# provision extern scripts
		server.vm.provision "shell", path: "scripts/install_p1_server.sh"
	end

	config.vm.define "rihoySW" do |worker|
		worker.vm.hostname = "rihoySW"
		worker.vm.network "private_network", ip: "192.168.56.111"
		
		worker.vm.provider "virtualbox" do |vb|
			vb.name = "rihoySW"
			vb.customize ["setproperty", "machinefolder", extern_path]
		end

		worker.vm.provision "shell", path: "scripts/install_p1_worker.sh"
	end
end